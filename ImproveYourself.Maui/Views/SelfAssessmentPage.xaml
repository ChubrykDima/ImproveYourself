<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="ImproveYourself.Maui.Views.SelfAssessmentPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="True"
             BackgroundColor="{StaticResource ColorBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="22,16,22,30"
                             Spacing="16">
            <Button x:Name="BackButton"
                    Text=""
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource ColorTextSecondary}"
                    FontFamily="OpenSansRegular"
                    FontSize="15"
                    IsVisible="False"
                    Clicked="OnBackClicked" />
            <HorizontalStackLayout x:Name="ProgressDots"
                                   Spacing="6"
                                   IsVisible="False">
                <Border WidthRequest="26"
                        HeightRequest="6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource ColorSurfaceRaised}" />
                <Border WidthRequest="26"
                        HeightRequest="6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource ColorSurfaceRaised}" />
                <Border WidthRequest="26"
                        HeightRequest="6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource ColorSurfaceRaised}" />
                <Border WidthRequest="26"
                        HeightRequest="6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource ColorAccent}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="22">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="EyebrowLabel"
                           Text=""
                           TextColor="{StaticResource ColorAccent}"
                           FontFamily="OpenSansRegular"
                           FontSize="15" />
                    <Label x:Name="TitleLabel"
                           Text=""
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label x:Name="DescriptionLabel"
                           Text=""
                           Style="{StaticResource BodyLabelStyle}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="QuestionsContainer"
                                 Spacing="12" />

            <Label x:Name="AssessmentValidationLabel"
                   Text=""
                   Style="{StaticResource BodyLabelStyle}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="SubmitButton"
                    Text=""
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"
                    Clicked="OnSubmitClicked" />

            <Border x:Name="ResultBorder"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="22"
                    IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ResultTitleLabel"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label x:Name="ResultBodyLabel"
                           Style="{StaticResource BodyLabelStyle}" />
                    <Button x:Name="ResultContinueButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnResultContinueClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
