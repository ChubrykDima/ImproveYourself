<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImproveYourself.Maui.Views.RegisterPage"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             BackgroundColor="{StaticResource ColorBackground}">
    <ScrollView x:Name="FormScroll"
                Orientation="Vertical">
        <VerticalStackLayout Padding="22,16,22,30"
                             Spacing="16"
                             HorizontalOptions="Fill">
            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="TitleLabel"
                           Style="{StaticResource SubtitleLabelStyle}" />
                    <Label x:Name="DescriptionLabel"
                           Style="{StaticResource BodyLabelStyle}"
                           LineBreakMode="WordWrap" />

                    <Entry x:Name="EmailEntry"
                           Keyboard="Email"
                           PlaceholderColor="{StaticResource ColorTextSecondary}"
                           FontFamily="OpenSansRegular"
                           FontSize="15"
                           TextColor="{StaticResource ColorTextPrimary}"
                           BackgroundColor="{StaticResource ColorFrame}"
                           HeightRequest="52" />

                    <Entry x:Name="PasswordEntry"
                           IsPassword="True"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False"
                           PlaceholderColor="{StaticResource ColorTextSecondary}"
                           FontFamily="OpenSansRegular"
                           FontSize="15"
                           TextColor="{StaticResource ColorTextPrimary}"
                           BackgroundColor="{StaticResource ColorFrame}"
                           HeightRequest="52" />

                    <Label x:Name="PasswordRulesLabel"
                           Style="{StaticResource BodyLabelStyle}" />

                    <Button x:Name="RegisterButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnRegisterClicked" />

                    <Label x:Name="LegalHintLabel"
                           Style="{StaticResource BodyLabelStyle}"
                           LineBreakMode="WordWrap" />

                    <Button x:Name="PrivacyPolicyButton"
                            LineBreakMode="WordWrap"
                            Clicked="OnPrivacyPolicyClicked" />
                    <Button x:Name="TermsButton"
                            LineBreakMode="WordWrap"
                            Clicked="OnTermsClicked" />

                    <Label x:Name="StatusLabel"
                           Style="{StaticResource BodyLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
