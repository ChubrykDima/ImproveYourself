<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <Compile Include="../../ImproveYourself.Maui/Persistence/SqliteChallengeRepository.cs" Link="SqliteChallengeRepository.cs" />
    <Compile Include="../../ImproveYourself.Maui/Persistence/IChallengeRepository.cs" Link="IChallengeRepository.cs" />
    <Compile Include="../../ImproveYourself.Maui/Application/ILocalizationService.cs" Link="ILocalizationService.cs" />
    <Compile Include="../../ImproveYourself.Maui/Domain/*.cs" Link="Domain/%(Filename)%(Extension)" />
    <Compile Include="../../ImproveYourself.Maui/Resources/Strings/AppStrings.cs" Link="AppStrings.cs" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/daily-challenges.ru.json" Link="course.ru.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/daily-challenges.en.json" Link="course.en.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/daily-challenges.de.json" Link="course.de.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/strings/ru.json" Link="strings.ru.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/strings/en.json" Link="strings.en.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ImproveYourself.Maui/Resources/Raw/strings/de.json" Link="strings.de.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
